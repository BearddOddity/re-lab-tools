+    /**
+     * Import a file from the Ghidra host filesystem and open it in the tool.
+     *
+     * The path is resolved inside Linux, not on the Windows side: put the file
+     * in the shared folder (/mnt/share) if it came from Windows.
+     */
+    private String importBinary(String path, boolean analyze) {
+        if (path == null || path.isEmpty()) return "path is required";
+        File file = new File(path);
+        if (!file.isFile()) {
+            return "File not found (this path is resolved inside Linux): " + path;
+        }
+        Project project = tool.getProject();
+        if (project == null) return "No project is open in Ghidra";
+
+        MessageLog log = new MessageLog();
+        try {
+            LoadResults<Program> results = AutoImporter.importByUsingBestGuess(
+                    file, project,
+                    project.getProjectData().getRootFolder().getPathname(),
+                    this, log, TaskMonitor.DUMMY);
+
+            Program program = results.getPrimaryDomainObject(this);
+            results.save(TaskMonitor.DUMMY);
+
+            String name = program.getName();
+            String lang = program.getLanguage().getLanguageID().toString();
+
+            // Analyse BEFORE handing the program to the tool. Opening an
+            // unanalysed program makes Ghidra raise a modal "Analysis Options"
+            // dialog, which blocks this HTTP handler until somebody clicks it.
+            if (analyze) {
+                analyzeProgram(program);
+            } else {
+                // Even when skipping analysis, suppress the prompt - an agent
+                // has no way to answer it.
+                int tx = program.startTransaction("GhidraMCP suppress analyze prompt");
+                try {
+                    GhidraProgramUtilities.markProgramNotToAskToAnalyze(program);
+                } finally {
+                    program.endTransaction(tx, true);
+                }
+            }
+
+            ProgramManager pm = tool.getService(ProgramManager.class);
+            if (pm != null) {
+                pm.openProgram(program);
+            }
+
+            // The tool holds its own reference now; drop ours.
+            results.release(this);
+
+            StringBuilder sb = new StringBuilder();
+            sb.append("Imported ").append(name).append("\n");
+            sb.append("source: ").append(path).append("\n");
+            sb.append("language: ").append(lang).append("\n");
+            sb.append("analysis: ").append(analyze ? "started" : "skipped").append("\n");
+            String logText = log.toString();
+            if (logText != null && !logText.trim().isEmpty()) {
+                sb.append("loader log:\n").append(logText);
+            }
+            return sb.toString();
+        } catch (Exception e) {
+            return "Import failed: " + e.getClass().getSimpleName() + ": " + e.getMessage();
+        }
+    }
+
+    private void analyzeProgram(Program program) {
+        int tx = program.startTransaction("GhidraMCP analysis");
+        try {
+            AutoAnalysisManager mgr = AutoAnalysisManager.getAnalysisManager(program);
+            mgr.initializeOptions();
+            mgr.reAnalyzeAll(null);
+            mgr.startAnalysis(TaskMonitor.DUMMY);
+            // Record that analysis happened. Without this the tool still asks,
+            // via a modal dialog that blocks the HTTP handler thread.
+            GhidraProgramUtilities.markProgramAnalyzed(program);
+        } finally {
+            program.endTransaction(tx, true);
+        }
+    }
+
+    private String analyzeCurrentProgram() {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        try {
+            analyzeProgram(program);
+            return "Analysis started on " + program.getName()
+                    + " (functions so far: " + program.getFunctionManager().getFunctionCount() + ")";
+        } catch (Exception e) {
+            return "Analysis failed: " + e.getMessage();
+        }
+    }
+
+    private String saveCurrentProgram() {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        try {
+            program.save("GhidraMCP save", TaskMonitor.DUMMY);
+            return "Saved " + program.getName();
+        } catch (Exception e) {
+            return "Save failed: " + e.getMessage();
+        }
+    }
+
+    /**
+     * Overwrite bytes in program memory. This changes the analysis database,
+     * not the file on disk - use export_program to write a patched binary out.
+     * The previous bytes are returned so a patch can be reversed.
+     */
+    private String patchBytes(String addressStr, String hex) {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        if (addressStr == null || addressStr.isEmpty()) return "address is required";
+        if (hex == null || hex.isEmpty()) return "bytes is required";
+
+        String h = hex.replaceAll("\\s+", "").replace("0x", "");
+        if (h.length() % 2 != 0) return "bytes must contain an even number of hex digits";
+        byte[] data = new byte[h.length() / 2];
+        for (int i = 0; i < data.length; i++) {
+            try {
+                data[i] = (byte) Integer.parseInt(h.substring(i * 2, i * 2 + 2), 16);
+            } catch (NumberFormatException e) {
+                return "Invalid hex pair at position " + i;
+            }
+        }
+
+        final AtomicReference<String> out = new AtomicReference<>("Patch did not run");
+        try {
+            SwingUtilities.invokeAndWait(() -> {
+                int tx = program.startTransaction("GhidraMCP patch bytes");
+                boolean ok = false;
+                try {
+                    Address addr = program.getAddressFactory().getAddress(addressStr);
+                    if (addr == null) {
+                        out.set("Invalid address: " + addressStr);
+                        return;
+                    }
+                    byte[] before = new byte[data.length];
+                    program.getMemory().getBytes(addr, before);
+                    program.getMemory().setBytes(addr, data);
+                    ok = true;
+                    out.set("Patched " + data.length + " byte(s) at " + addr
+                            + "\nbefore: " + toHexString(before)
+                            + "\nafter:  " + toHexString(data));
+                } catch (Exception e) {
+                    out.set("Patch failed: " + e.getMessage());
+                } finally {
+                    program.endTransaction(tx, ok);
+                }
+            });
+        } catch (Exception e) {
+            return "Patch failed: " + e.getMessage();
+        }
+        return out.get();
+    }
+
+    /**
+     * Export the program. format=binary writes raw memory bytes (patches
+     * included); format=original writes the originally imported file.
+     */
+    private String exportProgram(String path, String format) {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        if (path == null || path.isEmpty()) return "path is required";
+        String fmt = (format == null || format.isEmpty()) ? "binary" : format.toLowerCase();
+        File out = new File(path);
+        try {
+            Exporter exporter;
+            if (fmt.startsWith("orig")) {
+                exporter = new OriginalFileExporter();
+            } else if (fmt.startsWith("bin")) {
+                exporter = new BinaryExporter();
+            } else {
+                return "Unknown format '" + format + "' (use binary or original)";
+            }
+            boolean ok = exporter.export(out, program, null, TaskMonitor.DUMMY);
+            if (!ok) {
+                return "Export failed: " + exporter.getMessageLog().toString();
+            }
+            return "Exported " + program.getName() + " to " + out.getAbsolutePath()
+                    + " (" + fmt + ", " + out.length() + " bytes)";
+        } catch (Exception e) {
+            return "Export failed: " + e.getClass().getSimpleName() + ": " + e.getMessage();
+        }
+    }
