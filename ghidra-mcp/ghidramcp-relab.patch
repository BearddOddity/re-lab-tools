+    private String toHexString(byte[] data) {
+        StringBuilder sb = new StringBuilder();
+        for (byte b : data) sb.append(String.format("%02x", b & 0xFF));
+        return sb.toString();
+    }
+
+    /** Classic hex dump: address, 16 bytes, ASCII gutter. */
+    private String readBytes(String addressStr, int length) {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        if (addressStr == null || addressStr.isEmpty()) return "address is required";
+        if (length <= 0 || length > 4096) return "length must be between 1 and 4096";
+        try {
+            Address addr = program.getAddressFactory().getAddress(addressStr);
+            if (addr == null) return "Invalid address: " + addressStr;
+            byte[] buf = new byte[length];
+            int got = program.getMemory().getBytes(addr, buf);
+            if (got <= 0) return "No readable bytes at " + addressStr;
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < got; i += 16) {
+                StringBuilder hex = new StringBuilder();
+                StringBuilder ascii = new StringBuilder();
+                for (int j = 0; j < 16 && i + j < got; j++) {
+                    int b = buf[i + j] & 0xFF;
+                    hex.append(String.format("%02x ", b));
+                    ascii.append(b >= 0x20 && b < 0x7F ? (char) b : '.');
+                }
+                sb.append(String.format("%s  %-48s %s%n", addr.add(i), hex.toString(), ascii.toString()));
+            }
+            return sb.toString();
+        } catch (Exception e) {
+            return "Error reading bytes: " + e.getMessage();
+        }
+    }
+
+    /**
+     * Byte-pattern search. "??" or ".." marks a wildcard nibble pair, so
+     * "48??8b" matches 48 xx 8b - the usual way to write a signature that
+     * tolerates a varying register or relocated operand.
+     */
+    private String searchBytes(String pattern, int limit) {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        if (pattern == null || pattern.isEmpty()) return "pattern is required";
+        String p = pattern.replaceAll("\\s+", "").replace("0x", "");
+        if (p.length() % 2 != 0) return "pattern must contain an even number of hex digits";
+        int n = p.length() / 2;
+        if (n == 0) return "pattern is empty";
+        byte[] bytes = new byte[n];
+        byte[] mask = new byte[n];
+        for (int i = 0; i < n; i++) {
+            String tok = p.substring(i * 2, i * 2 + 2);
+            if (tok.equals("??") || tok.equals("..")) {
+                bytes[i] = 0;
+                mask[i] = 0;
+            } else {
+                try {
+                    bytes[i] = (byte) Integer.parseInt(tok, 16);
+                } catch (NumberFormatException e) {
+                    return "Invalid hex pair '" + tok + "' in pattern";
+                }
+                mask[i] = (byte) 0xFF;
+            }
+        }
+        StringBuilder sb = new StringBuilder();
+        Address at = program.getMinAddress();
+        int found = 0;
+        while (at != null && found < limit) {
+            Address hit = program.getMemory().findBytes(at, bytes, mask, true, TaskMonitor.DUMMY);
+            if (hit == null) break;
+            Function f = program.getFunctionManager().getFunctionContaining(hit);
+            sb.append(hit);
+            if (f != null) sb.append("  in ").append(f.getName());
+            sb.append("\n");
+            found++;
+            try {
+                at = hit.add(1);
+            } catch (Exception e) {
+                break;
+            }
+        }
+        if (found == 0) return "No matches for pattern: " + pattern;
+        return sb.toString();
+    }
+
+    /** Accept either a function name or an address inside it. */
+    private Function resolveFunction(String ident) {
+        Program program = getCurrentProgram();
+        if (program == null || ident == null || ident.isEmpty()) return null;
+        for (Function f : program.getFunctionManager().getFunctions(true)) {
+            if (f.getName().equals(ident)) return f;
+        }
+        try {
+            Address a = program.getAddressFactory().getAddress(ident);
+            if (a != null) return program.getFunctionManager().getFunctionContaining(a);
+        } catch (Exception ignored) {
+        }
+        return null;
+    }
+
+    private String listCallers(String ident) {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        Function f = resolveFunction(ident);
+        if (f == null) return "Function not found: " + ident;
+        StringBuilder sb = new StringBuilder();
+        for (Function c : f.getCallingFunctions(TaskMonitor.DUMMY)) {
+            sb.append(c.getName()).append(" @ ").append(c.getEntryPoint()).append("\n");
+        }
+        if (sb.length() == 0) return "No callers of " + f.getName();
+        return sb.toString();
+    }
+
+    private String listCallees(String ident) {
+        Program program = getCurrentProgram();
+        if (program == null) return "No program loaded";
+        Function f = resolveFunction(ident);
+        if (f == null) return "Function not found: " + ident;
+        StringBuilder sb = new StringBuilder();
+        for (Function c : f.getCalledFunctions(TaskMonitor.DUMMY)) {
+            sb.append(c.getName()).append(" @ ").append(c.getEntryPoint()).append("\n");
+        }
+        if (sb.length() == 0) return "No callees of " + f.getName();
+        return sb.toString();
+    }
