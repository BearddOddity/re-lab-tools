#!/bin/bash
# Launch Ghidra 12.1.3 (the one carrying the GhidraMCP extension) on the nested
# desktop, in the FOREGROUND.
#
# ghidraRun uses "launch.sh bg", which forks the JVM and returns immediately.
# When Ghidra is started from Windows via wsl.exe/wslg.exe that is fatal: the
# launcher exits, WSL tears the session down, and the orphaned JVM is killed
# seconds later. Running in fg keeps the JVM as a child of a live session.
#
# Keeping the argument list here rather than in a Windows command line also
# avoids PowerShell silently dropping the two empty "" arguments that
# launch.sh expects in positions 4 and 5.
set -u

GHIDRA=/opt/ghidra_12.1.3_PUBLIC
DISP="${DISP:-:10}"

if pgrep -f "ghidra.GhidraRun" >/dev/null 2>&1; then
    echo "Ghidra is already running."
    exit 0
fi

exec env -u WAYLAND_DISPLAY \
     DISPLAY="$DISP" \
     GDK_BACKEND=x11 \
     "$GHIDRA/support/launch.sh" fg jdk Ghidra "" "" ghidra.GhidraRun "$@"
