#!/usr/bin/env python3
"""re-triage - everything worth knowing about a binary before opening a disassembler.

    re-triage /mnt/share/crackme01.exe

Answers the questions that decide what to do next: is it packed, what language
built it, what can it actually do, and are there gift strings. Running this
first regularly saves an hour of reading a packer stub in the decompiler.
"""
import hashlib
import math
import os
import re
import subprocess
import sys
from collections import Counter

# Section names that give a packer away immediately.
PACKER_SECTIONS = {
    "upx0": "UPX", "upx1": "UPX", "upx2": "UPX", ".upx": "UPX",
    ".aspack": "ASPack", ".adata": "ASPack",
    ".themida": "Themida", ".winlice": "Themida/WinLicense",
    ".vmp0": "VMProtect", ".vmp1": "VMProtect", ".vmp2": "VMProtect",
    ".petite": "Petite", ".mpress1": "MPRESS", ".mpress2": "MPRESS",
    "pebundle": "PEBundle", ".nsp0": "NsPack", ".packed": "generic packer",
    "!epack": "EPack", ".yp": "Y0da", ".boom": "BoomProtect",
}

# Imports worth flagging, and why they matter for a crackme.
NOTABLE_IMPORTS = {
    "isdebuggerpresent": "anti-debug",
    "checkremotedebuggerpresent": "anti-debug",
    "ntqueryinformationprocess": "anti-debug (kernel-side)",
    "outputdebugstringa": "anti-debug (legacy trick)",
    "rdtsc": "timing check",
    "queryperformancecounter": "timing check",
    "gettickcount": "timing check",
    "getvolumeinformationa": "machine-bound key",
    "getvolumeinformationw": "machine-bound key",
    "getcomputernamea": "machine-bound key",
    "getcomputernamew": "machine-bound key",
    "getusernamea": "user-bound key",
    "virtualprotect": "self-modifying / unpacking",
    "virtualalloc": "self-modifying / unpacking",
    "loadlibrarya": "dynamic import resolution",
    "getprocaddress": "dynamic import resolution",
    "createfilea": "file access",
    "regopenkeyexa": "registry (licence storage?)",
    "cryptencrypt": "crypto",
    "cryptdecrypt": "crypto",
    "cryptcreatehash": "crypto",
}

INTERESTING_STRINGS = re.compile(
    r"(serial|licen[cs]e|registr|activat|key|password|passwd|congrat|correct|"
    r"wrong|invalid|incorrect|success|fail|denied|trial|expire|crack|patch|"
    r"flag\{|ctf\{)",
    re.I,
)


def is_identifier_noise(s):
    """True for symbol and struct names that only match by accident.

    "registr" hits _EXCEPTION_REGISTRATION_RECORD, "patch" hits
    ProcessImagesHotPatched, "activat" hits ActivationContextStackPointer.
    None of those are leads. Real leads are messages shown to a user, so they
    contain spaces or punctuation; bare CamelCase or SCREAMING_SNAKE runs are
    almost always internals.
    """
    if " " in s or "%" in s:
        return False
    if "_" in s:
        return True
    humps = sum(1 for i in range(1, len(s)) if s[i].isupper() and s[i - 1].islower())
    return humps >= 2


def entropy(data):
    if not data:
        return 0.0
    counts = Counter(data)
    n = len(data)
    return -sum((c / n) * math.log2(c / n) for c in counts.values())


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout
    except Exception:
        return ""


def head(title):
    print("\n" + title)
    print("-" * len(title))


def identity(path, data):
    head("Identity")
    print(f"path      : {path}")
    print(f"size      : {len(data):,} bytes")
    print(f"md5       : {hashlib.md5(data).hexdigest()}")
    print(f"sha256    : {hashlib.sha256(data).hexdigest()}")
    print(f"file      : {run(['file', '-b', path]).strip()}")
    e = entropy(data)
    note = ""
    if e > 7.2:
        note = "  <- very high: packed, compressed or encrypted"
    elif e > 6.8:
        note = "  <- high: possibly packed"
    print(f"entropy   : {e:.2f} / 8.00{note}")


def pe_report(path, data):
    try:
        import pefile
    except ImportError:
        print("(pefile not available)")
        return
    try:
        pe = pefile.PE(path, fast_load=False)
    except Exception as exc:
        print(f"(not a valid PE: {exc})")
        return

    head("PE")
    machine = pe.FILE_HEADER.Machine
    bits = {0x14C: "32-bit (x86)", 0x8664: "64-bit (x86-64)"}.get(machine, hex(machine))
    print(f"arch      : {bits}")
    print(f"subsystem : {pefile.SUBSYSTEM_TYPE.get(pe.OPTIONAL_HEADER.Subsystem, '?')}")
    print(f"entrypoint: 0x{pe.OPTIONAL_HEADER.AddressOfEntryPoint:x} "
          f"(imagebase 0x{pe.OPTIONAL_HEADER.ImageBase:x})")
    try:
        import datetime
        ts = datetime.datetime.fromtimestamp(pe.FILE_HEADER.TimeDateStamp,
                                             datetime.timezone.utc)
        print(f"built     : {ts:%Y-%m-%d %H:%M} UTC")
    except Exception:
        pass
    if bits.startswith("32"):
        print("run with  : re-run <file>   (32-bit prefix)")

    head("Sections")
    packers = set()
    for s in pe.sections:
        name = s.Name.rstrip(b"\x00").decode("latin-1", "replace")
        se = entropy(s.get_data())
        flag = ""
        hit = PACKER_SECTIONS.get(name.lower().strip())
        if hit:
            packers.add(hit)
            flag = f"  <- {hit}"
        elif se > 7.2 and s.SizeOfRawData:
            flag = "  <- high entropy"
        print(f"  {name:<10} vsize 0x{s.Misc_VirtualSize:<8x} raw 0x{s.SizeOfRawData:<8x} "
              f"entropy {se:.2f}{flag}")

    imports = []
    if hasattr(pe, "DIRECTORY_ENTRY_IMPORT"):
        for entry in pe.DIRECTORY_ENTRY_IMPORT:
            dll = entry.dll.decode("latin-1", "replace") if entry.dll else "?"
            for imp in entry.imports:
                if imp.name:
                    imports.append((dll, imp.name.decode("latin-1", "replace")))

    head(f"Imports ({len(imports)} from "
         f"{len(getattr(pe, 'DIRECTORY_ENTRY_IMPORT', []))} DLLs)")
    if len(imports) < 15:
        print("  few imports - typical of a packed binary that resolves them at runtime")
    notable = [(d, n, why) for d, n in imports
               for key, why in NOTABLE_IMPORTS.items() if n.lower() == key]
    if notable:
        for dll, name, why in notable:
            print(f"  {name:<32} {dll:<16} {why}")
    else:
        print("  (nothing on the watch list)")

    if packers:
        head("Packer")
        for p in sorted(packers):
            print(f"  {p} detected by section name")
        print("  Unpack before analysing. A packed binary decompiles into the")
        print("  packer stub, not the program. Try: upx -d <file>")


def elf_report(path):
    head("ELF")
    out = run(["readelf", "-hd", path])
    for line in out.splitlines():
        if any(k in line for k in ("Class:", "Machine:", "Type:", "Entry point",
                                   "NEEDED", "SONAME")):
            print("  " + line.strip())


def dynamic_api_report(all_strings):
    """APIs named in strings but absent from the import table.

    A binary that resolves an API through GetProcAddress leaves the name in
    .rdata and nothing in .idata, so an import-table scan misses it entirely.
    Anti-debug is very often hidden exactly this way - prime.exe reaches
    NtSetInformationThread (ThreadHideFromDebugger) without importing it.
    """
    hits = []
    for s in all_strings:
        token = s.strip()
        why = NOTABLE_IMPORTS.get(token.lower())
        if why:
            hits.append((token, why))
    # ntdll names worth flagging that are not in the import watch list
    extra = {
        "ntsetinformationthread": "anti-debug (ThreadHideFromDebugger)",
        "ntqueryobject": "anti-debug (debug object handle)",
        "ntcreatethreadex": "anti-debug (hidden thread)",
        "zwsetinformationthread": "anti-debug (ThreadHideFromDebugger)",
        "dbgbreakpoint": "anti-debug",
        "dbguidebugactiveprocess": "anti-debug",
        "blockinput": "anti-analysis",
        "outputdebugstringw": "anti-debug (legacy trick)",
    }
    for s in all_strings:
        token = s.strip()
        why = extra.get(token.lower())
        if why:
            hits.append((token, why))

    if hits:
        head("APIs named in strings (resolved dynamically?)")
        seen = set()
        for name, why in hits:
            if name.lower() in seen:
                continue
            seen.add(name.lower())
            print(f"  {name:<32} {why}")
        print("\n  These appear as text but may not be in the import table.")
        print("  GetProcAddress resolution hides them from an import scan.")


def strings_report(path):
    head("Strings")
    ascii_out = run(["strings", "-n", "6", path]).splitlines()
    wide_out = run(["strings", "-el", "-n", "6", path]).splitlines()
    # Short names like "NtQueryObject" need a lower threshold than 6.
    short_out = run(["strings", "-n", "4", path]).splitlines()
    dynamic_api_report(short_out + wide_out)
    print(f"ascii: {len(ascii_out)}   utf-16: {len(wide_out)}")
    if len(ascii_out) + len(wide_out) < 40:
        print("  very few strings - another sign of packing")

    hits = [s for s in ascii_out + wide_out if INTERESTING_STRINGS.search(s)]
    seen = set()
    unique = []
    for h in hits:
        h = h.strip()
        if h and h not in seen and not is_identifier_noise(h):
            seen.add(h)
            unique.append(h)
    if unique:
        print(f"\ninteresting ({len(unique)}, showing up to 25):")
        for s in unique[:25]:
            print("  " + (s[:110] + "..." if len(s) > 110 else s))
        print("\n  Cross-reference these in Ghidra. The function referencing a")
        print("  failure message is very often the check itself.")
    else:
        print("\n  no obvious licence/serial strings - they may be encrypted")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 1
    path = sys.argv[1]
    if not os.path.isfile(path):
        print(f"not a file: {path}", file=sys.stderr)
        return 1

    with open(path, "rb") as fh:
        data = fh.read()

    identity(path, data)
    if data[:2] == b"MZ":
        pe_report(path, data)
    elif data[:4] == b"\x7fELF":
        elf_report(path)
    strings_report(path)

    head("Next")
    print("  import_binary(path=\"%s\")" % path)
    print("  then get_program_info(), list_imports(), list_strings(filter=...)")
    return 0


sys.exit(main())
